---
interface Props {
  current: 'scales' | 'notes' | 'intervals' | 'chords' | 'progressions';
}

const { current } = Astro.props;
const tabs = [
  { id: 'scales', href: '/theory/fretboard', label: 'Лады и аккорды' },
  { id: 'notes', href: '/theory/notes', label: 'Ноты' },
  { id: 'intervals', href: '/theory/intervals', label: 'Интервалы' },
  { id: 'chords', href: '/theory/chords', label: 'Аккорд' },
  { id: 'progressions', href: '/theory/progressions', label: 'Прогрессии' },
];
---

<nav class="theory-tabs" aria-label="Инструменты">
  {tabs.map((tab) => (
    <a href={tab.href} aria-current={tab.id === current ? 'page' : undefined}>{tab.label}</a>
  ))}
</nav>

<style>
  .theory-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
  }

  .theory-tabs a {
    padding: 6px 0 9px;
    margin-bottom: -1px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .theory-tabs a:hover {
    color: var(--fg);
  }

  .theory-tabs [aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
    border-bottom-color: var(--accent);
    view-transition-name: theory-tab;
  }
</style>
